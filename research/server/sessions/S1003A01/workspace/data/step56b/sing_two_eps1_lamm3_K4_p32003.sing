LIB "elim.lib";
option(redSB);
ring r=32003,(a,b,c,A,B,C,X1),dp;
ideal I=A*B*a*b*c^2 + A*C*a*b^2*c + B*C*a^2*b*c + a^4 - 3*a^2*b^2*c^2 - 2*a^2*b^2 - 2*a^2*c^2 + b^4 - 2*b^2*c^2 + c^4,
A*X1*b*c - A*b*c - B*X1*a*c - C*a*b + 2*X1*a^2 - 2*X1*b^2 + 2*b^2,
-2*A*B*X1*a*b*c^2 - 2*A*C*X1*a*b^2*c + 8*A*X1*a^2*b*c + 2*B^2*X1*a^2*c^2 + 2*B*C*X1*a^2*b*c - 8*B*X1*a^3*c + 4*B*a*b^2*c - 4*C*X1*a^3*b + 4*C*X1*a*b^3 + 12*X1*a^4 - 8*X1*a^2*b^2 - 4*X1*a^2*c^2 - 4*X1*b^4 + 4*X1*b^2*c^2 - 6*a^2*b^2*c^2 - 4*a^2*b^2 + 4*b^4 - 4*b^2*c^2,
16*A^2*X1*a^2*b^2*c^2 + 4*A*B^2*X1*a^2*b*c^3 + 8*A*B*C*X1*a^2*b^2*c^2 - 40*A*B*X1*a^3*b*c^2 + 4*A*C^2*X1*a^2*b^3*c - 32*A*C*X1*a^3*b^2*c + 88*A*X1*a^4*b*c - 12*A*X1*a^2*b^3*c^3 - 24*A*X1*a^2*b^3*c - 16*A*X1*a^2*b*c^3 - 12*A*a^2*b^3*c^3 - 8*A*a^2*b^3*c - 4*B^3*X1*a^3*c^3 - 8*B^2*C*X1*a^3*b*c^2 + 24*B^2*X1*a^4*c^2 + 8*B^2*a^2*b^2*c^2 - 4*B*C^2*X1*a^3*b^2*c + 32*B*C*X1*a^4*b*c - 72*B*X1*a^5*c + 12*B*X1*a^3*b^2*c^3 + 8*B*X1*a^3*b^2*c + 24*B*X1*a^3*c^3 - 8*B*X1*a*b^2*c^3 - 12*B*a^3*b^2*c^3 - 8*B*a^3*b^2*c + 16*B*a*b^4*c - 8*B*a*b^2*c^3 + 8*C^2*X1*a^4*b^2 - 8*C^2*X1*a^2*b^4 - 48*C*X1*a^5*b + 32*C*X1*a^3*b^3 + 8*C*X1*a^3*b*c^2 + 16*C*X1*a*b^5 - 8*C*X1*a*b^3*c^2 - 12*C*a^3*b^3*c^2 - 8*C*a*b^3*c^2 + 88*X1*a^6 - 12*X1*a^4*b^2*c^2 - 56*X1*a^4*b^2 - 48*X1*a^4*c^2 + 12*X1*a^2*b^4*c^2 - 24*X1*a^2*b^4 + 48*X1*a^2*b^2*c^2 - 8*X1*a^2*c^4 - 8*X1*b^6 + 8*X1*b^2*c^4 - 8*a^4*b^2 + 12*a^2*b^4*c^2 + 16*a^2*b^2*c^2 + 8*b^6 - 8*b^2*c^4,
