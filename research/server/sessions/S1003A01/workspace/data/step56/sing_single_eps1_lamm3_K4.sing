LIB "elim.lib";
option(redSB);
ring r=0,(a,b,c,A,B,C),dp;
ideal I=A*B*a*b*c^2 + A*C*a*b^2*c + B*C*a^2*b*c + a^4 - 3*a^2*b^2*c^2 - 2*a^2*b^2 - 2*a^2*c^2 + b^4 - 2*b^2*c^2 + c^4,
-B*c - C*b + 2*a,
A*B*b*c^2 + A*C*b^2*c + 2*A*a*b*c + 4*a^3 - 6*a*b^2*c^2 - 4*a*b^2 - 4*a*c^2,
-A^2*B*a*b^2*c^3 - A^2*C*a*b^3*c^2 + 2*A^2*a^2*b^2*c^2 + 8*A*a^4*b*c + 2*B*a^5*c - 9*B*a^3*b^2*c^3 - 8*B*a^3*b^2*c - 2*B*a*b^4*c + 4*B*a*b^2*c^3 - 2*B*a*c^5 + 2*C*a^5*b - 9*C*a^3*b^3*c^2 - 8*C*a^3*b*c^2 - 2*C*a*b^5 + 4*C*a*b^3*c^2 - 2*C*a*b*c^4 + 4*a^6 + 6*a^4*b^2*c^2 - 4*a^2*b^4 + 8*a^2*b^2*c^2 - 4*a^2*c^4,
4*A^3*a^2*b^3*c^3 + 36*A^2*a^4*b^2*c^2 - 6*A^2*a^2*b^4*c^4 - 4*A^2*a^2*b^4*c^2 - 4*A^2*a^2*b^2*c^4 + 4*A*B*a^5*b*c^2 - 24*A*B*a^3*b^3*c^4 - 16*A*B*a^3*b^3*c^2 + 4*A*B*a*b^5*c^2 - 8*A*B*a*b^3*c^4 + 4*A*B*a*b*c^6 + 4*A*C*a^5*b^2*c - 24*A*C*a^3*b^4*c^3 - 16*A*C*a^3*b^2*c^3 + 4*A*C*a*b^6*c - 8*A*C*a*b^4*c^3 + 4*A*C*a*b^2*c^5 + 32*A*a^6*b*c + 36*A*a^4*b^3*c^3 - 16*A*a^2*b^5*c + 32*A*a^2*b^3*c^3 - 16*A*a^2*b*c^5 - 18*B^2*a^4*b^2*c^4 - 16*B^2*a^4*b^2*c^2 - 8*B^2*a^2*b^4*c^2 + 8*B^2*a^2*b^2*c^4 - 36*B*C*a^4*b^3*c^3 - 8*B*C*a^2*b^5*c + 16*B*C*a^2*b^3*c^3 - 8*B*C*a^2*b*c^5 + 12*B*a^5*b^2*c^3 - 16*B*a^3*b^4*c + 16*B*a^3*b^2*c^3 - 18*C^2*a^4*b^4*c^2 - 16*C^2*a^4*b^2*c^2 + 8*C^2*a^2*b^4*c^2 - 8*C^2*a^2*b^2*c^4 + 12*C*a^5*b^3*c^2 + 16*C*a^3*b^3*c^2 - 16*C*a^3*b*c^4 + 8*a^8 + 72*a^6*b^2*c^2 + 24*a^6*b^2 + 24*a^6*c^2 - 54*a^4*b^4*c^4 - 60*a^4*b^4*c^2 - 8*a^4*b^4 - 60*a^4*b^2*c^4 - 48*a^4*b^2*c^2 - 8*a^4*c^4 - 12*a^2*b^6*c^2 - 24*a^2*b^6 + 24*a^2*b^4*c^4 + 24*a^2*b^4*c^2 - 12*a^2*b^2*c^6 + 24*a^2*b^2*c^4 - 24*a^2*c^6;
ideal J=sat(I,a*b*c)[1];
print("dim(J) (Krull, incl. complex):"); print(dim(std(J)));
poly s0=C*a*b - a^2 - b^2 + c^2;
ideal Js0=sat(J,s0)[1];
print("strict saturation 0:"); print(Js0); print(dim(std(Js0)));
poly s1=B*a*c - a^2 + b^2 - c^2;
ideal Js1=sat(J,s1)[1];
print("strict saturation 1:"); print(Js1); print(dim(std(Js1)));
quit;
