LIB "elim.lib";
option(redSB);
ring r=0,(a,b,c,A,B,C,l),dp;
ideal I=A*B*b*c^2 + A*C*b^2*c + B*C*a*b*c + a^3 + a*b^2*c^2*l,
-B*c - C*b - 2*a,
A*B*b*c^2 + A*C*b^2*c - 2*A*a*b*c + 4*a^3 + 2*a*b^2*c^2*l,
-A^2*B*b^2*c^3 - A^2*C*b^3*c^2 - 2*A^2*a*b^2*c^2 + 8*A*a^3*b*c + 2*B*a^4*c + 3*B*a^2*b^2*c^3*l + 2*C*a^4*b + 3*C*a^2*b^3*c^2*l - 4*a^5 + 2*a^3*b^2*c^2*l,
A^3*B*b^3*c^4 + A^3*C*b^4*c^3 - 2*A^3*a*b^3*c^3 + 28*A^2*a^3*b^2*c^2 + 2*A^2*a*b^4*c^4*l + 2*A*B*a^4*b*c^2 + 5*A*B*a^2*b^3*c^4*l + 2*A*C*a^4*b^2*c + 5*A*C*a^2*b^4*c^3*l - 28*A*a^5*b*c + 10*A*a^3*b^3*c^3*l + 6*B^2*a^3*b^2*c^4*l + 12*B*C*a^3*b^3*c^3*l + 4*B*a^4*b^2*c^3*l + 6*C^2*a^3*b^4*c^2*l + 4*C*a^4*b^3*c^2*l + 8*a^7 - 24*a^5*b^2*c^2*l - 6*a^3*b^4*c^4*l^2;
ideal J=sat(I,a*b*c)[1];
print("dim(J) (Krull, incl. complex):"); print(dim(std(J)));
poly s0=4*B^2*c^2 + 4*B*C*b*c + 12*B*a*c + 4*C^2*b^2 + 12*C*a*b + 12*a^2;
ideal Js0=sat(J,s0)[1];
print("strict saturation 0:"); print(Js0); print(dim(std(Js0)));
quit;
