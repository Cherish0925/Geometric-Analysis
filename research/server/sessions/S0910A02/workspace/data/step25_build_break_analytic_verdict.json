  "traceless_collar_analysis": {
    "step20_flat_residual": "(1+2A)/4, identical to base curvature effect, not new",
    "step19_corner_matching": "Full Ricci tensor checked through first nontrivial order in Fermi coordinates; traceless included; A free",
    "collar_behavior": "u = log w ~ log r + smooth(s), v ~ log r - smooth(s) near rod. Singularity is fixed by unit slope; regular part is what Step 19 corner matching constrains.",
    "conclusion": "No additional obstruction from the traceless equation on the collar. BUILD theorem needs a GLOBAL PDE solvability argument, not a local or integral one."
  },
  "stream_function_energy": {
    "identity": "int |grad psi|^2 = 2 int w^2 + 4 int K_B w^2",
    "limitation": "Involves w^2-weighted curvature int K_B w^2, which can be small when w is small at the rods. No lower bound on total flux follows."
  },
  "summed_rod_identity": {
    "identity": "int_Omega w dA = m + sum_i int_{rod_i} K_edge Q_i ds",
    "constant_A_formula": "int w = m/(1+2A)",
    "alpha_family": "A = m^alpha => int w ~ m^{1-alpha} -> 0 for alpha > 1",
