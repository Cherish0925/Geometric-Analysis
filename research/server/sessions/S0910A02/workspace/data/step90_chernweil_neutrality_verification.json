  "entropy_inaccessibility": {
    "theorem": "For any A\u2081 resolution M of any real-hyperbolic 4-orbifold O: d\u00b7\u03c7(Y) \u2264 \u03c7_orb(O) for any degree-d map M\u2192Y (Y closed hyperbolic). Hence Sambusetti can never obstruct Einstein metrics on M.",
    "proof_chain": [
      "Near-pinched construction \u27f9 Ric_{g_a} \u2265 \u2212(3+\u03b5_a)g, Vol(g_a) \u2192 Vol(O)",
      "Rescale \u27f9 Ric \u2265 \u22123g', Vol(g') \u2192 Vol(O)",
      "BCG (BBCG Thm 1.1) \u27f9 d\u00b7Vol(Y) \u2264 Vol(O)",
      "Hyperbolic: \u03c7 = 3Vol/(4\u03c0\u00b2) \u27f9 d\u00b7\u03c7(Y) \u2264 \u03c7_orb(O)",
      "Chern\u2013Weil non-decrease \u27f9 \u03c7(M)\u2212(3/2)|\u03c4(M)| \u2265 \u03c7_orb(O) \u2265 d\u00b7\u03c7(Y)",
      "\u2234 Sambusetti inequality \u03c7(M)\u2265(3/2)|\u03c4(M)|+d\u00b7\u03c7(Y) always satisfied \u220e"
    ],
    "answers_step88_question": "NEGATIVE for ALL orbifold+ALE resolutions",
    "note": "Argument uses only: ALE inequality, near-pinched construction, BCG. Independent of node count, chirality pattern, specific lattice, \u03c0\u2081 computation."
  },
  "triple_disjointness": {
    "theorem": "All three known families of no-Einstein certificates are independently blind to the audited near-pinched orbifold+ALE construction.",
    "mechanisms": [
      {
        "name": "PSC / Weitzenb\u00f6ck \u22a5 monopole/BF",
