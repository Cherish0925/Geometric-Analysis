LIB "elim.lib";
option(redSB);
ring r=0,(a,b,c,A,B,C,l),dp;
ideal I=A*B*a*b*c^2 + A*C*a*b^2*c + B*C*a^2*b*c + a^2*b^2*c^2*l + b^4 + 2*b^2*c^2 + c^4,
-B*c - C*b,
A*B*c + A*C*b + 2*a*b*c*l,
-A^2*B*a*b^2*c^3 - A^2*C*a*b^3*c^2 - A*B^2*a^2*b*c^3 - 2*A*B*C*a^2*b^2*c^2 - A*C^2*a^2*b^3*c + B*a^3*b^2*c^3*l - 2*B*a*b^4*c - 4*B*a*b^2*c^3 - 2*B*a*c^5 + C*a^3*b^3*c^2*l - 2*C*a*b^5 - 4*C*a*b^3*c^2 - 2*C*a*b*c^4,
2*A^2*a^2*b^4*c^4*l + 8*A*B*a^3*b^3*c^4*l + 4*A*B*a*b^5*c^2 + 8*A*B*a*b^3*c^4 + 4*A*B*a*b*c^6 + 8*A*C*a^3*b^4*c^3*l + 4*A*C*a*b^6*c + 8*A*C*a*b^4*c^3 + 4*A*C*a*b^2*c^5 + 3*B^2*a^4*b^2*c^4*l - 6*B^2*a^2*b^4*c^2 - 4*B^2*a^2*b^2*c^4 + 2*B^2*a^2*c^6 + 6*B*C*a^4*b^3*c^3*l - 4*B*C*a^2*b^5*c - 8*B*C*a^2*b^3*c^3 - 4*B*C*a^2*b*c^5 + 3*C^2*a^4*b^4*c^2*l + 2*C^2*a^2*b^6 - 4*C^2*a^2*b^4*c^2 - 6*C^2*a^2*b^2*c^4 - 2*a^4*b^4*c^4*l^2 + 4*a^2*b^6*c^2*l + 8*a^2*b^4*c^4*l + 4*a^2*b^2*c^6*l;
ideal J=sat(I,a*b*c)[1];
print("dim(J) (Krull, incl. complex):"); print(dim(std(J)));
poly s0=4*B^2*a^2*c^2 + 4*B*C*a^2*b*c - 4*B*a*b^2*c - 4*B*a*c^3 + 4*C^2*a^2*b^2 + 4*C*a*b^3 + 4*C*a*b*c^2 + 4*b^4 + 8*b^2*c^2 + 4*c^4;
ideal Js0=sat(J,s0)[1];
print("strict saturation 0:"); print(Js0); print(dim(std(Js0)));
quit;
