a^3*b^5 - 160*C*X1*a^3*b^3*c^2 + 16*C*X1*a^3*b*c^4 + 48*C*X1*a*b^7 - 16*C*X1*a*b^3*c^4 + 24*C*a^3*b^5*c^2 + 32*C*a^3*b^3*c^2 - 32*C*a*b^3*c^4 + 768*X1*a^8 - 192*X1*a^6*b^2*c^2 - 544*X1*a^6*b^2 - 576*X1*a^6*c^2 + 96*X1*a^4*b^4*c^2 - 224*X1*a^4*b^4 + 96*X1*a^4*b^2*c^4 + 640*X1*a^4*b^2*c^2 - 64*X1*a^4*c^4 + 96*X1*a^2*b^6*c^2 + 32*X1*a^2*b^6 - 96*X1*a^2*b^4*c^4 - 64*X1*a^2*b^4*c^2 + 32*X1*a^2*b^2*c^4 - 32*X1*b^8 + 32*X1*b^4*c^4 + 24*a^6*b^2*c^2 - 108*a^4*b^4*c^4 - 96*a^4*b^4*c^2 - 32*a^4*b^4 - 48*a^4*b^2*c^4 + 72*a^2*b^6*c^2 - 96*a^2*b^4*c^4 + 24*a^2*b^2*c^6 + 32*b^8 - 32*b^4*c^4;
ideal J=sat(I,a*b*c*X1*(1-X1))[1];
print("dim(J) (Krull, incl. complex):"); print(dim(std(J)));
poly s0=-4*A^2*X1*b^2*c^2 + 4*A^2*b^2*c^2 - 4*A*C*X1*a*b^2*c + 4*A*C*a*b^2*c - 4*A*X1*a^2*b*c + 12*A*X1*b^3*c + 4*A*X1*b*c^3 + 4*A*a^2*b*c - 12*A*b^3*c - 4*A*b*c^3 + 4*B^2*X1*a^2*c^2 + 4*B*C*X1*a^2*b*c - 12*B*X1*a^3*c + 4*B*X1*a*b^2*c - 4*B*X1*a*c^3 + 4*C^2*a^2*b^2 - 8*C*X1*a^3*b + 8*C*X1*a*b^3 - 4*C*a^3*b - 12*C*a*b^3 + 4*C*a*b*c^2 + 8*X1*a^4 + 8*X1*a^2*c^2 - 8*X1*b^4 - 8*X1*b^2*c^2 + 4*a^4 - 8*a^2*c^2 + 12*b^4 + 4*c^4;
