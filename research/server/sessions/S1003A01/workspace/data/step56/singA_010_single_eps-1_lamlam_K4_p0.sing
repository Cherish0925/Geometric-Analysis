LIB "elim.lib";
option(redSB);
ring r=0,(a,b,c,A,B,C,l),dp;
ideal I=A*B*a*c^2 + A*C*a*b*c + B*C*a^2*c + a^2*b*c^2*l + b^3,
-B*c - C*b,
A*B*c + A*C*b + 2*a*b*c*l,
-A^2*B*a*b*c^3 - A^2*C*a*b^2*c^2 - A*B^2*a^2*c^3 - 2*A*B*C*a^2*b*c^2 - A*C^2*a^2*b^2*c + B*a^3*b*c^3*l - 2*B*a*b^3*c + C*a^3*b^2*c^2*l - 2*C*a*b^4,
A^2*B^2*a^2*b*c^4 + A^2*B*C*a^2*b^2*c^3 + 2*A^2*a^2*b^3*c^4*l + A*B^3*a^3*c^4 + 2*A*B^2*C*a^3*b*c^3 + A*B*C^2*a^3*b^2*c^2 + 8*A*B*a^3*b^2*c^4*l + 4*A*B*a*b^4*c^2 + 8*A*C*a^3*b^3*c^3*l + 4*A*C*a*b^5*c + 2*B^2*a^4*b*c^4*l - 4*B^2*a^2*b^3*c^2 + 5*B*C*a^4*b^2*c^3*l - 2*B*C*a^2*b^4*c + 3*C^2*a^4*b^3*c^2*l + 2*C^2*a^2*b^5 - 2*a^4*b^3*c^4*l^2 + 4*a^2*b^5*c^2*l;
ideal J=sat(I,a*b*c)[1];
print("dim(J) (Krull, incl. complex):"); print(dim(std(J)));
poly s0=4*B^2*a^2*c^2 + 4*B*C*a^2*b*c - 4*B*a*b^2*c + 4*C^2*a^2*b^2 + 4*C*a*b^3 + 4*b^4;
ideal Js0=sat(J,s0)[1];
print("strict saturation 0:"); print(Js0); print(dim(std(Js0)));
quit;
